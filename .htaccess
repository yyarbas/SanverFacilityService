# ═══════════════════════════════════════════════════════════
#  .htaccess — Sanver Facility Service
#  Hosting: mein.manitu.de (Apache Shared Hosting)
#  Domain:  sanver-facilityservice.de
# ═══════════════════════════════════════════════════════════

Options -Indexes
ServerSignature Off

# ── www hinzufügen ──────────────────────────────────────────
# Hinweis: HTTPS wird von Manitu automatisch erzwungen (SSL-Proxy).
# Daher hier NUR www-Weiterleitung — kein HTTP→HTTPS (würde Redirect-Loop verursachen).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ── Sicherheits-Header ──────────────────────────────────────
<IfModule mod_headers.c>
  # Kein Clickjacking
  Header always set X-Frame-Options "DENY"

  # Kein MIME-Sniffing
  Header always set X-Content-Type-Options "nosniff"

  # HTTPS für 1 Jahr erzwingen
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Referrer kontrollieren
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Unnötige Browser-Features deaktivieren
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Content Security Policy
  # Hinweis: 'unsafe-inline' für style/script wird benötigt (kein Build-Step)
  # Sobald Cal.com eingerichtet ist: cal.sanver-facilityservice.de ergänzen
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cal.eu; style-src 'self' 'unsafe-inline' https://cal.eu; img-src 'self' data: https:; font-src 'self' https://cal.eu; connect-src 'self' https://cal.eu; frame-src https://cal.eu; object-src 'none'; base-uri 'self'; form-action 'self' https://cal.eu;"

  # Server-Info verstecken
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>

# ── Fehlerseiten ────────────────────────────────────────────
ErrorDocument 404 /index.html

# ── Caching für statische Dateien ──────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # Bilder — 1 Jahr
  ExpiresByType image/png             "access plus 1 year"
  ExpiresByType image/jpeg            "access plus 1 year"
  ExpiresByType image/gif             "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 year"
  ExpiresByType image/webp            "access plus 1 year"
  ExpiresByType image/x-icon          "access plus 1 year"

  # Fonts — 1 Jahr
  ExpiresByType font/woff2            "access plus 1 year"
  ExpiresByType font/woff             "access plus 1 year"

  # CSS & JS — 1 Monat
  ExpiresByType text/css              "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"

  # HTML — nie cachen (sofortige Updates)
  ExpiresByType text/html             "access plus 0 seconds"
</IfModule>

# ── Gzip-Komprimierung ──────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Angriffspfade blockieren ────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^\.git            - [F,L]
  RewriteRule ^\.env            - [F,L]
  RewriteRule wp-login\.php     - [F,L]
  RewriteRule xmlrpc\.php       - [F,L]
</IfModule>
