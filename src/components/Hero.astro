---
---
<section class="hero" id="hero">
  <div class="container hero-inner">
    <div class="hero-content">
      <div class="hero-eyebrow">
        <span>✦</span> Neu in 2026 · Erfahren seit Jahren
      </div>
      <h1>
        Sauberkeit,<br />
        die <span class="highlight">überzeugt.</span>
      </h1>
      <p class="hero-sub">
        Sanver Facility Service steht für professionelle Gebäudereinigung und umfassendes Facility Management — gegründet 2026 von Enes Sanver und einem Team, das sein Handwerk in- und auswendig kennt.
      </p>
      <div class="hero-actions">
        <a href="#termin" class="btn btn-primary">Jetzt Termin buchen →</a>
        <a href="#leistungen" class="btn btn-white">Unsere Leistungen</a>
      </div>
      <div class="hero-divider"></div>
      <div class="hero-stats">
        <div class="stat">
          <strong>100%</strong>
          <span>Zufriedenheitsgarantie</span>
        </div>
        <div class="stat">
          <strong>24/7</strong>
          <span>Erreichbar</span>
        </div>
        <div class="stat">
          <strong>Neu</strong>
          <span>Gegründet 2026</span>
        </div>
      </div>
    </div>

    <div class="hero-visual">
      <div class="hero-glow"></div>
      <div class="hero-badge badge-tl">
        <span class="dot"></span> Jetzt verfügbar
      </div>
      <div class="hero-logo-card">
        <img src="/media/sanver-logo-hero-hd.png" alt="Sanver Facility Service Logo" />
        <p class="tagline">„Ihr Gebäude. Unsere Leidenschaft."</p>
      </div>
      <div class="hero-badge badge-br">
        📍 Frankfurt · Rhein-Main-Gebiet
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(145deg, #0D2154 0%, #1B3A7A 50%, #1A5FA0 100%);
    padding: 90px 0 80px; overflow: hidden; position: relative;
  }
  .hero::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 80% 60% at 70% 50%, rgba(41,171,226,0.15) 0%, transparent 70%);
    pointer-events: none;
  }
  .hero-inner {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 60px; align-items: center; position: relative;
  }
  .hero-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(41,171,226,0.15); color: var(--blue-light);
    border: 1px solid rgba(41,171,226,0.3);
    font-size: .75rem; font-weight: 700; letter-spacing: .1em;
    text-transform: uppercase; padding: 6px 16px; border-radius: 100px; margin-bottom: 24px;
  }
  .hero h1 {
    color: var(--white);
    font-size: clamp(2.4rem, 4.5vw, 3.6rem);
    font-weight: 900; margin-bottom: 22px; line-height: 1.08;
  }
  .hero h1 .highlight {
    color: var(--blue);
    position: relative; display: inline-block;
  }
  .hero-sub {
    color: rgba(255,255,255,0.72); font-size: 1.08rem;
    margin-bottom: 40px; max-width: 500px; line-height: 1.7;
  }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 52px; }
  .hero-divider {
    height: 1px; background: rgba(255,255,255,0.12);
    margin-bottom: 36px;
  }
  .hero-stats { display: flex; gap: 40px; }
  .hero-stats .stat strong { display: block; font-size: 1.8rem; font-weight: 900; color: var(--blue); line-height: 1; }
  .hero-stats .stat span { font-size: .82rem; color: rgba(255,255,255,0.55); margin-top: 4px; display: block; }

  .hero-visual { position: relative; display: flex; justify-content: center; align-items: center; }
  .hero-logo-card {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.2);
    backdrop-filter: blur(20px);
    border-radius: 28px;
    padding: 52px 48px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.25);
    position: relative; z-index: 1;
    text-align: center;
  }
  .hero-logo-card img { width: 260px; height: auto; }
  .hero-logo-card .tagline {
    margin-top: 18px; color: rgba(255,255,255,0.65); font-size: .85rem;
    font-style: italic; letter-spacing: .03em;
  }

  .hero-badge {
    position: absolute;
    background: var(--white); color: var(--navy);
    font-weight: 700; font-size: .82rem;
    padding: 10px 18px; border-radius: 100px;
    box-shadow: var(--shadow-lg); white-space: nowrap;
    display: flex; align-items: center; gap: 7px; z-index: 2;
  }
  .hero-badge .dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--green); flex-shrink: 0;
    animation: pulse 2s infinite;
  }
  .badge-tl { top: -18px; left: -18px; }
  .badge-br { bottom: -18px; right: -18px; }

  .hero-glow {
    position: absolute; width: 400px; height: 400px;
    background: var(--blue); opacity: .08; border-radius: 50%;
    filter: blur(60px); pointer-events: none;
  }

  @keyframes pulse {
    0%,100% { box-shadow: 0 0 0 0 rgba(93,184,90,.4); }
    50%      { box-shadow: 0 0 0 6px rgba(93,184,90,0); }
  }

  @media(max-width:900px){
    .hero-inner { grid-template-columns: 1fr; gap: 48px; }
    .hero-visual { max-width: 420px; margin: 0 auto; }
    .badge-tl { top: -12px; left: 12px; }
    .badge-br { bottom: -12px; right: 12px; }
  }
  @media(max-width:520px){
    .hero-actions { flex-direction: column; }
    .hero-stats { gap: 24px; }
  }
</style>
