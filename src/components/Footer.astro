---
const currentYear = new Date().getFullYear();
---
<footer class="footer" id="kontakt">
  <div class="container footer-inner">
    <div class="footer-brand">
      <div class="footer-logo">
        <img src="/media/sanver-logo-nav.png" alt="Sanver Facility Service" />
      </div>
      <p>Professionelle Gebäudereinigung und Facility Management — Einzelunternehmen, gegründet 2026 von Enes Sanver. Verwurzelt in Frankfurt, tätig im Rhein-Main-Gebiet.</p>
      <div class="footer-contacts">
        <span><span>📍</span> <span class="footer-highlight">Schöffenstraße 28, 65933 Frankfurt am Main</span></span>
        <a href="tel:+491779139257"><span>📞</span> +49 177 9139257</a>
        <a href="mailto:info@sanver-facilityservice.de"><span>✉️</span> <span class="footer-highlight">info@sanver-facilityservice.de</span></a>
      </div>
    </div>

    <div class="footer-col">
      <h4>Leistungen</h4>
      <ul>
        <li><a href="#leistungen">Büroreinigung</a></li>
        <li><a href="#leistungen">Unterhaltsreinigung</a></li>
        <li><a href="#leistungen">Grundreinigung</a></li>
        <li><a href="#leistungen">Glasreinigung</a></li>
        <li><a href="#leistungen">Desinfektion</a></li>
        <li><a href="#leistungen">Winterdienst</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Unternehmen</h4>
      <ul>
        <li><a href="#ueber-uns">Über uns</a></li>
        <li><a href="#vorteile">Warum Sanver?</a></li>
        <li><a href="#ablauf">Ablauf</a></li>
        <li><a href="#termin">Termin buchen</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Rechtliches</h4>
      <ul>
        <li><a href="/impressum">Impressum</a></li>
        <li><a href="/datenschutz">Datenschutzerklärung</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>© {currentYear} Sanver Facility Service · Enes Sanver · Einzelunternehmen</p>
      <p>Frankfurt am Main · Rhein-Main-Gebiet 🇩🇪 · <a href="/impressum">Impressum</a> · <a href="/datenschutz">Datenschutz</a></p>
    </div>
  </div>
</footer>

