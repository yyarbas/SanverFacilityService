<section id="termin" class="booking">
  <div class="container booking-inner">
    <div class="booking-info">
      <span class="tag">Termin buchen</span>
      <h2>Kostenloses Erstgespräch vereinbaren</h2>
      <p>Kein langes Hin und Her. Buchen Sie direkt einen Termin — wir besprechen Ihr Objekt, Ihre Anforderungen und machen Ihnen ein unverbindliches Angebot.</p>
      <ul class="booking-perks">
        <li><span class="perk-check">✓</span> Kostenlos &amp; unverbindlich</li>
        <li><span class="perk-check">✓</span> Persönlicher Gesprächspartner: Enes Sanver</li>
        <li><span class="perk-check">✓</span> Angebot innerhalb von 24 Stunden</li>
        <li><span class="perk-check">✓</span> Flexibel — vor Ort, per Video oder Telefon</li>
      </ul>
      <a href="tel:+491779139257" class="btn btn-secondary">📞 Direkt anrufen <span style="font-size:.75rem;opacity:.7">+49 177 9139257</span></a>
    </div>

    <div class="booking-card">
      <div class="booking-card-header">
        <h3>📅 Termin wählen</h3>
        <p>Wählen Sie einen passenden Zeitslot in unserem Kalender</p>
      </div>
      <div class="booking-card-body">
        <div class="cal-toggle">
          <button class="cal-toggle-btn active" onclick="switchCal('30min',this)">30 Min — Erstgespräch</button>
          <button class="cal-toggle-btn" onclick="switchCal('15min',this)">15 Min — Kurze Anfrage</button>
        </div>
        <iframe
          id="cal-embed"
          src="https://www.cal.eu/sanver-facilityservice/30min?embed=true&embedType=inline&theme=light"
          width="100%"
          height="620"
          style="border:none;display:block;"
          title="Termin buchen"
          loading="lazy"
        ></iframe>
        <div class="cal-divider"></div>
        <div class="contact-direct">
          <a href="mailto:info@sanver-facilityservice.de" class="contact-link">
            <span>✉️</span> info@sanver-facilityservice.de
          </a>
          <a href="tel:+491779139257" class="contact-link">
            <span>📞</span> +49 177 9139257
          </a>
          <a href="https://wa.me/491779139257?text=Hallo%2C%20ich%20m%C3%B6chte%20einen%20Termin%20vereinbaren." class="contact-link contact-link-wa">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" style="flex-shrink:0" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
              <path d="M12 0C5.373 0 0 5.373 0 12c0 2.113.549 4.099 1.51 5.831L.057 23.57a.5.5 0 0 0 .609.61l5.819-1.456A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.808 9.808 0 0 1-5.006-1.371l-.36-.213-3.714.929.946-3.629-.234-.374A9.818 9.818 0 0 1 2.182 12C2.182 6.57 6.57 2.182 12 2.182S21.818 6.57 21.818 12 17.43 21.818 12 21.818z"/>
            </svg>
            <span>WhatsApp schreiben — 0177 9139257</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  function switchCal(slug, btn) {
    document.querySelectorAll('.cal-toggle-btn').forEach(function(b){ b.classList.remove('active'); });
    btn.classList.add('active');
    document.getElementById('cal-embed').src =
      'https://www.cal.eu/sanver-facilityservice/' + slug + '?embed=true&embedType=inline&theme=light';
  }
</script>

<style>
  .booking { background: var(--gray-50); }
  .booking-inner {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 64px; align-items: center;
  }
  .booking-info h2 { margin-bottom: 16px; }
  .booking-info > p { font-size: 1.02rem; line-height: 1.75; margin-bottom: 28px; }
  .booking-perks { list-style: none; display: flex; flex-direction: column; gap: 14px; margin-bottom: 32px; }
  .booking-perks li { display: flex; align-items: center; gap: 12px; font-size: .93rem; color: var(--gray-900); font-weight: 500; }
  .perk-check {
    width: 26px; height: 26px; background: var(--green); color: white;
    border-radius: 50%; display: flex; align-items: center; justify-content: center;
    font-size: .7rem; font-weight: 800; flex-shrink: 0;
  }
  .booking-card {
    background: var(--white); border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg); border: 1px solid var(--gray-100);
    overflow: hidden;
  }
  .booking-card-header {
    background: linear-gradient(135deg, var(--navy), var(--navy-mid));
    padding: 28px 32px; text-align: center;
  }
  .booking-card-header h3 { color: white; font-size: 1.2rem; margin-bottom: 6px; }
  .booking-card-header p { color: rgba(255,255,255,0.65); font-size: .88rem; margin: 0; }
  .booking-card-body { padding: 0 0 32px; }
  .cal-toggle {
    display: flex; gap: 0; padding: 16px 24px 0;
  }
  .cal-toggle-btn {
    flex: 1; padding: 10px 16px; font-size: .88rem; font-weight: 600;
    border: 1.5px solid var(--blue-pale); background: var(--gray-50);
    color: var(--gray-500); cursor: pointer; transition: all .15s;
  }
  .cal-toggle-btn:first-child { border-radius: var(--radius) 0 0 var(--radius); }
  .cal-toggle-btn:last-child  { border-radius: 0 var(--radius) var(--radius) 0; border-left: none; }
  .cal-toggle-btn.active { background: var(--navy); color: white; border-color: var(--navy); }
  .cal-toggle-btn:hover:not(.active) { background: var(--blue-pale); color: var(--navy); }
  .cal-divider { height: 1px; background: var(--gray-100); margin: 0 24px 24px; }
  .contact-direct { display: flex; flex-direction: column; gap: 12px; padding: 0 24px; }
  .contact-link {
    display: flex; align-items: center; gap: 12px;
    background: var(--gray-50); border-radius: var(--radius);
    padding: 14px 18px; text-decoration: none;
    color: var(--navy); font-weight: 600; font-size: .9rem;
    border: 1px solid var(--gray-100); transition: background .15s, border-color .15s;
  }
  .contact-link:hover { background: var(--blue-pale); border-color: var(--blue); }
  .contact-link-wa { background: #f0fdf4; border-color: #bbf7d0; color: #166534; }
  .contact-link-wa:hover { background: #dcfce7; border-color: #4ade80; }
  .contact-link span:first-child { font-size: 1.2rem; }

  @media(max-width:900px){ .booking-inner { grid-template-columns: 1fr; gap: 48px; } }
</style>
