---
const services = [
  {
    icon: '🧹',
    title: 'Gebäudereinigung',
    desc: 'Professionelle Unterhalts-, Glas- und Sonderreinigung für Büros, Industrie und öffentliche Gebäude. Täglich, wöchentlich oder nach Bedarf.',
  },
  {
    icon: '🔧',
    title: 'Technisches Gebäudemanagement',
    desc: 'Wartung und Instandhaltung von Heizungs-, Lüftungs- und Klimaanlagen, Elektrotechnik, Sanitär und Aufzügen.',
  },
  {
    icon: '🌿',
    title: 'Außenanlagenpflege',
    desc: 'Pflege von Grünanlagen, Winterdienst, Schneeräumung und Streudienst — zuverlässig und termingerecht.',
  },
  {
    icon: '🔒',
    title: 'Sicherheitsdienste',
    desc: 'Objektschutz, Empfangsdienste und Kontrollgänge durch geschultes und zertifiziertes Sicherheitspersonal.',
  },
  {
    icon: '♻️',
    title: 'Abfallmanagement',
    desc: 'Entsorgungslogistik, Wertstofftrennung und nachhaltige Abfallwirtschaft gemäß deutschem Kreislaufwirtschaftsgesetz.',
  },
  {
    icon: '📋',
    title: 'Infrastrukturelles FM',
    desc: 'Post- und Botendienste, Catering-Koordination, Umzugsservice und Flächenmanagement aus einer Hand.',
  },
];
---
<section id="leistungen" class="services">
  <div class="container">
    <div class="services-header">
      <span class="section-label">Unsere Leistungen</span>
      <h2>Alles aus einer Hand</h2>
      <p class="services-intro">
        Wir bieten das komplette Spektrum des Facility Managements — individuell zugeschnitten auf Ihre Liegenschaft und Anforderungen.
      </p>
    </div>

    <div class="services-grid">
      {services.map((s) => (
        <div class="service-card">
          <div class="service-icon">{s.icon}</div>
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services { background: var(--white); }

  .services-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 56px;
  }

  .services-intro { font-size: 1.05rem; margin-top: 8px; }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .service-card {
    background: var(--gray-50);
    border: 2px solid transparent;
    border-radius: 16px;
    padding: 36px 28px;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .service-card:hover {
    border-color: var(--yellow-400);
    box-shadow: var(--shadow);
    transform: translateY(-4px);
  }

  .service-icon {
    font-size: 2.4rem;
    margin-bottom: 16px;
    display: block;
  }

  .service-card p { font-size: 0.92rem; }

  @media (max-width: 900px) {
    .services-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .services-grid { grid-template-columns: 1fr; }
  }
</style>
